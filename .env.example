# ============================================================
# CodePilot AI — 环境变量模板
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 排除。
# 任何情况下都不要把真实密钥写进本文件或提交到仓库。
# ============================================================

# ---- 模型服务（OpenAI 兼容协议）----
# 只需要改这三项即可切换供应商，业务代码无需改动。
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# OpenAI:   https://api.openai.com/v1
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=qwen-plus

# 单次请求的整体超时（毫秒）。超出后返回 TIMEOUT 错误。
AI_TIMEOUT_MS=60000

# ---- 限流（单实例内存计数，多实例部署时按实例独立计算）----
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60

# ---- Supabase ----
# 位置：Project Settings → API Keys（旧教程里的 "Settings → API" 页面已不存在）
# 当前阶段（任务 8）只需要 URL + 一个服务端密钥，二选一填写：
#   - 新版：API Keys → Publishable and secret API keys → Secret keys（sb_secret_ 开头）
#   - 旧版：API Keys → Legacy API Keys → service_role（eyJ 开头的 JWT）
# 该密钥绕过所有 RLS，**绝不能**加 NEXT_PUBLIC_ 前缀，也不能出现在任何客户端组件里。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key
# SUPABASE_SERVICE_ROLE_KEY=eyJ-your-legacy-service-role-key

# 任务 13 接入登录后才需要（可先留空）：
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
