# ============================================================
# CodePilot AI — 环境变量模板
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 排除。
# 任何情况下都不要把真实密钥写进本文件或提交到仓库。
# ============================================================

# ---- 模型服务（OpenAI 兼容协议）----
# 只需要改这三项即可切换供应商，业务代码无需改动。
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# OpenAI:   https://api.openai.com/v1
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=qwen-plus

# 单次请求的整体超时（毫秒）。超出后返回 TIMEOUT 错误。
AI_TIMEOUT_MS=60000

# ---- 限流（单实例内存计数，多实例部署时按实例独立计算）----
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60

# ---- Supabase ----
# 当前阶段（任务 8）只需要下面两项：服务端用 service_role 访问数据库。
# SUPABASE_SERVICE_ROLE_KEY 拥有绕过 RLS 的完全权限，**绝不能**加 NEXT_PUBLIC_ 前缀，
# 也不能出现在任何客户端组件里；它只在本机 .env.local 与部署平台的密钥管理中保存。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 任务 13 接入登录后才需要（可先留空）：
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
