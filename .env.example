# ============================================================
# CodePilot AI — 环境变量模板
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 排除。
# 任何情况下都不要把真实密钥写进本文件或提交到仓库。
# ============================================================

# ---- 模型服务（OpenAI 兼容协议）----
# 只需要改这三项即可切换供应商，业务代码无需改动。
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# OpenAI:   https://api.openai.com/v1
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=qwen-plus

# 单次请求的整体超时（毫秒）。超出后返回 TIMEOUT 错误。
AI_TIMEOUT_MS=60000

# ---- 限流（单实例内存计数，多实例部署时按实例独立计算）----
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60

# ---- Supabase：浏览器可用配置（可公开）----
# 位置：Project Settings → API Keys → Publishable and secret API keys → Publishable key
# 这把钥匙能不能看到数据，完全由 RLS 决定，所以加 NEXT_PUBLIC_ 前缀是安全的。
# 大小写敏感：变量名必须与 src/lib/env.ts 里读的完全一致。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ---- Supabase：服务端管理密钥（绝不能公开）----
# 位置：同一个页面的 Secret keys（sb_secret_ 开头）或 Legacy 的 service_role（eyJ 开头）
# 它绕过所有 RLS，只用于脚本与后台操作（建表、建测试账号）。
# **绝不能**加 NEXT_PUBLIC_ 前缀，也不能出现在任何客户端组件里。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key
# SUPABASE_SERVICE_ROLE_KEY=eyJ-your-legacy-service-role-key
